# ==========================================
# RailTrack API Configuration
# ==========================================

# Option 1: RapidAPI Indian Railways API (Recommended for instant access)
# Get your free key at: https://rapidapi.com/apidojo/api/irctc1/ or https://rapidapi.com/hax007/api/indian-railway-irctc
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Option 2: Alternate Railway API (e.g., Railofy, IndianRailAPI)
# RAILWAY_API_URL=https://indianrailapi.com/api/v2
# RAILWAY_API_KEY=your_api_key_here
